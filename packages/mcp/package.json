{
  "name": "@staddress/mcp",
  "version": "0.2.1",
  "description": "Model Context Protocol (MCP) server for the Staddress AI address parsing API (stdio and Streamable HTTP)",
  "author": "StaddressAI",
  "homepage": "https://staddress.com/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StaddressAI/staddress-tools.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/StaddressAI/staddress-tools/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "staddress-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "mcpb:validate": "npx --yes @anthropic-ai/mcpb validate mcpb/manifest.json",
    "mcpb:pack": "bash scripts/pack-mcpb.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "staddress",
    "mcp",
    "model-context-protocol",
    "address",
    "geocoding",
    "japan"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@staddress/client": "^0.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}

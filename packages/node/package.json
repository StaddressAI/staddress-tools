{
  "name": "@staddress/client",
  "version": "0.1.0",
  "description": "Official Node.js client for Staddress AI address parsing API",
  "author": "StaddressAI",
  "homepage": "https://staddress.com/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StaddressAI/staddress-tools.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/StaddressAI/staddress-tools/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "staddress",
    "address",
    "geocoding",
    "japan"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
